# Required
OPENROUTER_API_KEY=sk-or-v1-...

# Optional defaults
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
OPENROUTER_IMAGE_PROVIDER=google-vertex,google-ai-studio
OPENROUTER_IMAGE_ALLOW_FALLBACKS=true
OPENROUTER_IMAGE_OUTPUT_DIR=./openrouter-images
OPENROUTER_IMAGE_INLINE_PREVIEW=true
OPENROUTER_IMAGE_PREVIEW_MAX_PX=768
OPENROUTER_IMAGE_TIMEOUT=180
OPENROUTER_IMAGE_ASK_FOR_PROVIDER=false
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=openrouter-image-mcp
OPENROUTER_APP_URL=https://github.com/sneffets/openrouter-image-mcp

# Video
OPENROUTER_VIDEO_MODEL=google/veo-3.1
OPENROUTER_VIDEO_OUTPUT_DIR=./openrouter-videos
OPENROUTER_VIDEO_POLL_INTERVAL=15
OPENROUTER_VIDEO_MAX_WAIT=600
